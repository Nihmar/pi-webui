{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "outDir": "dist",
    "rootDir": "src",
    "emitDeclarationOnly": false,
    "declaration": false,
    "sourceMap": false,
    "jsx": "react-jsx",
    "types": ["node"]
  },
  "include": ["src/server/**/*", "src/shared/**/*"]
}
